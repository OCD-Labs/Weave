# Copy to .env and fill in real values. Never commit .env to git.

CHAIN_ID=46630
RPC_URL=https://rpc.testnet.chain.robinhood.com
ALCHEMY_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/YOUR_API_KEY
ALCHEMY_WS_URL=wss://robinhood-testnet.g.alchemy.com/v2/YOUR_API_KEY

PRIVATE_KEY=0xYOUR_PRIVATE_KEY
DEPLOYER_ADDRESS=0xYOUR_DEPLOYER_ADDRESS

# Source: https://docs.robinhood.com/chain/contracts
USDG_ADDRESS=0x7E955252E15c84f5768B83c41a71F9eba181802F
TSLA_ADDRESS=0xC9f9c86933092BbbfFF3CCb4b105A4A94bf3Bd4E
AMZN_ADDRESS=0x5884aD2f920c162CFBbACc88C9C51AA75eC09E02
PLTR_ADDRESS=0x1FBE1a0e43594b3455993B5dE5Fd0A7A266298d0
NFLX_ADDRESS=0x3b8262A63d25f0477c4DDE23F83cfe22Cb768C93
AMD_ADDRESS=0x71178BAc73cBeb415514eB542a8995b82669778d

WEAVE_REGISTRY_ADDRESS=
BASKET_FACTORY_ADDRESS=
BASKET_IMPLEMENTATION_ADDRESS=
WEAVE_AUTOMATION_ADDRESS=
MOCK_SWAP_ROUTER_ADDRESS=
MOCK_ORACLE_TSLA=
MOCK_ORACLE_AMZN=
MOCK_ORACLE_PLTR=
MOCK_ORACLE_NFLX=
MOCK_ORACLE_AMD=

API_PORT=8080
DB_PATH=./backend/weave.db
PRICE_POLL_INTERVAL_SECS=60

AI_SERVICE_PORT=3001

# Options: ollama | anthropic | openai  (default: ollama)
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ANTHROPIC_API_KEY=sk-ant-...

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

DEPLOY_BLOCK=65989689
AI_BASE_URL=

# ── Oracle prices (8-decimal USD) — update before every deployment ───────────
# Formula: price_in_usd * 1e8. Example: $415.55 → 41555000000
TSLA_PRICE_8DEC=41555000000
AMZN_PRICE_8DEC=26206000000
PLTR_PRICE_8DEC=15815000000
NFLX_PRICE_8DEC=8585000000
AMD_PRICE_8DEC=49701000000